#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp ESCAPE  &kp N1  &kp N2  &kp N3        &kp N4          &kp N5          &kp N6         &kp N7     &kp N8     &kp N9   &kp N0     &kp RIGHT_BRACKET
&kp GRAVE   &kp Q   &kp W   &kp E         &kp R           &kp T           &kp Y          &kp U      &kp I      &kp O    &kp P      &kp LEFT_BRACKET
&to 1       &kp A   &kp S   &kp D         &kp F           &kp G           &kp H          &kp J      &kp K      &kp L    &kp SEMI   &kp APOS
&mo 2       &kp Z   &kp X   &kp C         &kp V           &kp B           &kp N          &kp M      &kp COMMA  &kp DOT  &kp SLASH  &kp DELETE
                            &kp CAPSLOCK  &kp TAB         &kp LEFT_ALT    &kp BACKSPACE  &kp SPACE
                                          &kp LEFT_SHIFT  &kp LCTRL       &kp ENTER
            >;
        };

        secondary {
            bindings = <
&kp PRINTSCREEN  &kp F1    &kp F2  &kp F3    &kp F4     &kp F5          &kp F6         &kp F7          &kp F8           &kp F9     &kp F10        &kp F11
&trans           &trans    &trans  &trans    &trans     &trans          &trans         &trans          &trans           &kp UNDER  &kp PLUS       &trans
&to 0            &trans    &trans  &trans    &trans     &trans          &trans         &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp MINUS  &kp EQUAL      &trans
&trans           &kp EXCL  &trans  &trans    &trans     &trans          &trans         &kp LBKT        &kp RBKT         &trans     &kp BACKSLASH  &kp DELETE
                                   &kp CAPS  &kp TAB    &kp LEFT_ALT    &kp BACKSPACE  &kp SPACE
                                             &kp LSHFT  &kp LCTRL       &kp ENTER
            >;
        };

        navigation {
            bindings = <
&trans   &trans         &trans    &trans    &trans     &trans       &trans         &trans     &trans    &trans     &trans  &trans
&trans   &trans         &trans    &trans    &trans     &trans       &trans         &trans     &trans    &trans     &trans  &trans
&kp F12  &kp PAGE_UP    &kp HOME  &trans    &trans     &trans       &trans         &trans     &kp UP    &trans     &trans  &trans
&mo 0    &kp PAGE_DOWN  &kp END   &trans    &trans     &trans       &trans         &kp LEFT   &kp DOWN  &kp RIGHT  &trans  &kp F12
                                  &kp CAPS  &kp TAB    &kp LALT     &kp BACKSPACE  &kp SPACE
                                            &kp LSHFT  &kp LCTRL    &kp ENTER
            >;
        };

        Mouse {
            bindings = <
&none  &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &studio_unlock
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none  &none         &none         &mkp MCLK     &none      &none         &none       &none      &mkp MCLK     &none         &none         &none
&none  &trans        &mkp RCLK     &mo 0         &mkp LCLK  &none         &none       &mkp LCLK  &mo 0         &mkp RCLK     &trans        &trans
                                   &none         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                 &none      &none         &none
            >;
        };
    };
};
